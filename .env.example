# Optional: Node 22+ reads this file via `node --env-file=.env src/server.js`.
PORT=3000
# Omit DATA_DIR to save to .data/ under the project root.
# DATA_DIR=/your/persistent/directory
# Configure a workspace access token before exposing this service beyond trusted users.
# PLATFORM_TOKEN=replace-with-a-long-random-value
# Comma-separated exact HTTPS hostnames for external Agent services (no wildcards).
# AGENT_ALLOWED_HOSTS=agent.example.com
# Secret values stay on the server. UI stores only the variable name.
# AGENT_SECRET_COMMERCE=your-server-side-secret
