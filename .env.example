# Optional: Node 22+ reads this file via `node --env-file=.env src/server.js`.
PORT=3000
# Omit DATA_DIR to save to .data/ under the project root.
# DATA_DIR=/your/persistent/directory
# Configure a workspace access token before exposing this service beyond trusted users.
# PLATFORM_TOKEN=replace-with-a-long-random-value
# Comma-separated exact HTTPS hostnames for external Agent services (no wildcards).
# AGENT_ALLOWED_HOSTS=agent.example.com
# Secret values stay on the server. UI stores only the variable name.
# AGENT_SECRET_COMMERCE=your-server-side-secret

# Workforce model connection: store only the variable NAME in the UI.
# Set the real value here on your server; never commit .env.
# MODEL_SECRET_PRIMARY=your-model-api-key
# AGENT_ALLOWED_HOSTS must also include the exact model endpoint hostname.

# Personal computer only: Codex SDK uses your own ChatGPT login (no API key).
# ENABLE_CODEX_LOCAL=1
# PLATFORM_TOKEN=choose-a-private-local-workspace-token
# Enabling this bridge forces HTTP binding to 127.0.0.1.

# Optional knowledge/CMS/supplier adapter credentials; UI stores only this name.
# SOURCE_SECRET_CMS=your-source-api-key
# Add the adapter HTTPS hostname to existing AGENT_ALLOWED_HOSTS (comma-separated).

# Optional embedding service. BM25 works without these settings.
# KB_EMBEDDING_ENDPOINT=https://your-provider.example.com/v1/embeddings
# KB_EMBEDDING_MODEL=your-embedding-model
# KB_EMBEDDING_KEY=your-embedding-api-key
# Add this endpoint hostname to existing AGENT_ALLOWED_HOSTS.

# Optional Dify Workflow / external skill credentials. Store the VALUE only here.
# EXTERNAL_SECRET_DIFY=your-workflow-application-key
# Merge the exact external hostname into existing AGENT_ALLOWED_HOSTS.
# Dify Cloud example: api.dify.ai; self-hosted: your public HTTPS hostname.

# Optional web search: configure Tavily or a readonly remote MCP search tool in the UI.
# SEARCH_SECRET_PRIMARY=your-search-service-key
# Add api.tavily.com (Tavily) or the exact MCP server hostname to AGENT_ALLOWED_HOSTS.
# This is separate from model credentials and ChatGPT subscription usage.
# Optional store authorization gateway (not the storefront URL).
# STORE_SECRET_PRIMARY=your-authorized-gateway-key
# Add the gateway hostname to AGENT_ALLOWED_HOSTS. This gateway remains read-only.

# Official store connection (V0.15): existing app + authorized store access token.
# PLATFORM_TOKEN is REQUIRED for real product writes; use it to log into this app.
# Merge required official domains with your existing allowed hosts:
# AGENT_ALLOWED_HOSTS=eco.taobao.com,openapi-fxg.jinritemai.com
# STORE_APP_KEY_PRIMARY=your-app-key-or-app-id
# STORE_APP_SECRET_PRIMARY=your-app-secret
# STORE_ACCESS_TOKEN_PRIMARY=your-authorized-store-access-token
# UI stores the variable names above, never their values. Use different suffixes per shop.
# Start with: node --env-file=.env src/server.js
# Token refresh/OAuth redirects are not implemented; renew expired tokens server-side.

# Optional image generation / editing through OpenAI Images-compatible service.
# Requires PLATFORM_TOKEN; independent API usage (not ChatGPT Plus/Pro subscription).
# IMAGE_SECRET_PRIMARY=your-image-api-key
# Add api.openai.com (or configured provider) AND authorized reference-image CDN hosts
# to existing AGENT_ALLOWED_HOSTS and environment network policy.
# Configure API base URL + image model under AI基础能力配置 -> 图片生成.

# Gemini native image generation (choose Google Gemini in the image settings UI).
# IMAGE_SECRET_GEMINI=your-new-server-side-google-api-key
# Add generativelanguage.googleapis.com to existing AGENT_ALLOWED_HOSTS and network policy.
# PLATFORM_TOKEN is also required. Model example: gemini-2.5-flash-image (editable).
# The read-only connection check does not generate an image or verify image billing.
