{
  "manifest_version": 3,
  "name": "电商工作台 · 云电脑连接器",
  "version": "1.7.1",
  "description": "连接工作台，自动收集 1688 搜索报价、识别美团商品与闲鱼发布表单。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*.meituan.com/*",
    "https://*.goofish.com/*",
    "https://detail.1688.com/*"
  ],
  "action": {
    "default_popup": "pair.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "key": "",
  "host_permissions": [
    "https://s.1688.com/*",
    "https://cbu01.alicdn.com/*",
    "https://cbu02.alicdn.com/*",
    "https://cbu03.alicdn.com/*",
    "https://cbu04.alicdn.com/*",
    "https://img.alicdn.com/*",
    "https://imgextra.alicdn.com/*",
    "https://gw.alicdn.com/*",
    "https://img1.alicdn.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.app.github.dev/*",
      "https://2760932471-ai.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
